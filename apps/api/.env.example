BUSINESS_TIMEZONE=Asia/Shanghai
DATABASE_URL=postgresql+psycopg://demo:demo@localhost:5432/jiaowogui
SESSION_TTL_MINUTES=4320
# 演示时钟偏移的共享文件，API 与 worker 读同一份；相对路径按 apps/api 解析。
# 文件缺失或内容不可用时按零偏移（真实时间）处理。
DEMO_CLOCK_FILE=.demo_clock.json

# 先申请学校获准模型接口；不要把密钥写进代码、截图或聊天。
AGENT_PROVIDER=DISABLED
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_API_KEY=
AGENT_TIMEOUT_SECONDS=20
AGENT_TOTAL_SECONDS=60
AGENT_MAX_ROUNDS=4
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_RESPONSE_BYTES=1048576
AGENT_MAX_OUTPUT_TOKENS=1000
