# 复制为 .env 使用；.env 不提交。这里只允许合成口令，禁止真实密钥与学校数据。

COMPOSE_PROJECT_NAME=jiaowogui

# PostgreSQL（docker compose up -d postgres 会读这几项）
POSTGRES_USER=demo
POSTGRES_PASSWORD=***
POSTGRES_DB=jiaowogui
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 后端 apps/api/.env 使用
DATABASE_URL=postgresql+psycopg://demo:demo@localhost:5432/jiaowogui
BUSINESS_TIMEZONE=Asia/Shanghai
SESSION_TTL_MINUTES=4320
DEMO_LOGIN_PASSWORD=***

# 演示参数（非校规）
PASS_TTL_SECONDS=300
VERIFICATION_WINDOW_MINUTES=30
NIGHT_GATE_START=00:00
NIGHT_GATE_END=06:00
# 业务夜 D 的名单汇总时刻，同时是该夜首次申请截止；24:00 即 D+1 00:00，之后该夜只允许改期/撤销，次夜申请不受影响
DORM_SUMMARY_AT=24:00
COUNSELOR_DAILY_AT=08:30
COUNSELOR_WEEKLY_AT=Mon 09:00
# 受控导出内容的保留天数；到期后任务行留作审计，CSV 内容清空、下载改判 410（校方可改）
EXPORT_RETENTION_DAYS=7

# 前端 apps/web/.env.local 使用
VITE_API_BASE_URL=/api/v1

# 契约与 SDK
SDK_TARGET=preview
